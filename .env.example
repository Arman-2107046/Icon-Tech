# Copy to .env and fill in. Validated at boot by src/lib/env.ts.
# Required now: DATABASE_URL, SESSION_SECRET. Email becomes required when
# transactional emails are wired up. Payments are cash-on-delivery only and
# uploads are stored under public/uploads, so no gateway or storage keys.

# ---- Database ---------------------------------------------------------------
# PostgreSQL connection string used by Prisma (local database: Icon-tech)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/Icon-tech?schema=public"

# ---- Store ------------------------------------------------------------------
# Store currency. BDT is the default; USD is behind this flag.
NEXT_PUBLIC_STORE_CURRENCY="BDT"
# Public origin of the storefront, no trailing slash. Used for canonical URLs,
# sitemap, OG images, and payment redirect URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Auth -------------------------------------------------------------------
# Signs session and guest-cart cookies. At least 32 random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# ---- Cron -------------------------------------------------------------------
# Shared secret sent as the Authorization header by the scheduler that calls
# /api/cron/* (e.g. inventory reservation release).
CRON_SECRET=""

# ---- Email (Resend + React Email) -------------------------------------------
# Optional locally: without it queued emails are marked SKIPPED, not sent.
# The sender name/address is set in Admin → Settings → Email sender.
RESEND_API_KEY="re_..."
