# Copy to .env and fill in. Validated at boot by src/lib/env.ts.
# Required now: DATABASE_URL, SESSION_SECRET. The rest become required as
# each service is wired up.

# ---- Database ---------------------------------------------------------------
# PostgreSQL connection string used by Prisma (local database: Icon-tech)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/Icon-tech?schema=public"

# ---- Store ------------------------------------------------------------------
# Store currency. BDT is the default; USD is behind this flag.
STORE_CURRENCY="BDT"
# Public origin of the storefront, no trailing slash. Used for canonical URLs,
# sitemap, OG images, and payment redirect URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Auth -------------------------------------------------------------------
# Signs session and guest-cart cookies. At least 32 random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# ---- Cron -------------------------------------------------------------------
# Shared secret sent as the Authorization header by the scheduler that calls
# /api/cron/* (e.g. inventory reservation release).
CRON_SECRET=""

# ---- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
# From `stripe listen` locally or the dashboard webhook endpoint in production.
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ---- SSLCommerz -------------------------------------------------------------
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
# "true" uses the sandbox gateway; "false" uses live.
SSLCOMMERZ_SANDBOX="true"

# ---- Email (Resend + React Email) -------------------------------------------
RESEND_API_KEY="re_..."
# Sender shown on transactional emails, e.g. "Icon Tech <orders@example.com>"
EMAIL_FROM=""

# ---- Storage (Cloudflare R2) ------------------------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Public base URL that serves objects from the bucket, no trailing slash.
R2_PUBLIC_URL="https://media.example.com"
