// catalog module schema. Models for this module live here.
// Merged with the other files in prisma/schema/ by Prisma.

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Product {
  id             String        @id @default(cuid())
  handle         String        @unique
  title          String
  description    String        @default("")
  status         ProductStatus @default(DRAFT)
  vendor         String?
  tags           String[]      @default([])
  seoTitle       String?       @map("seo_title")
  seoDescription String?       @map("seo_description")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  options     ProductOption[]
  variants    Variant[]
  collections CollectionProduct[]

  @@index([status])
  @@index([vendor])
  @@map("products")
}

/// A product-level axis such as "Size" or "Colour". Values form the matrix
/// that generates variants.
model ProductOption {
  id        String  @id @default(cuid())
  productId String  @map("product_id")
  name      String
  position  Int     @default(0)

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@unique([productId, name])
  @@index([productId, position])
  @@map("product_options")
}

model ProductOptionValue {
  id       String @id @default(cuid())
  optionId String @map("option_id")
  value    String
  position Int    @default(0)

  option   ProductOption        @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants VariantOptionValue[]

  @@unique([optionId, value])
  @@index([optionId, position])
  @@map("product_option_values")
}

/// A purchasable SKU. All money columns are integer minor units in the
/// store currency (see src/lib/money.ts). Never store floats.
model Variant {
  id             String   @id @default(cuid())
  productId      String   @map("product_id")
  title          String
  sku            String?  @unique
  barcode        String?
  price          Int
  compareAtPrice Int?     @map("compare_at_price")
  cost           Int?
  weightGrams    Int?     @map("weight_grams")
  position       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  product      Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues VariantOptionValue[]

  @@index([productId, position])
  @@index([barcode])
  @@map("variants")
}

/// Which option value a variant carries on each axis, e.g. Size=M, Colour=Red.
model VariantOptionValue {
  variantId     String @map("variant_id")
  optionValueId String @map("option_value_id")

  variant     Variant            @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
  @@map("variant_option_values")
}

enum MediaOwnerType {
  PRODUCT
  VARIANT
  COLLECTION
  PAGE
}

/// Uploaded image or video. Polymorphic: (ownerType, ownerId) points at the
/// owning row, so there is no FK. Width/height/blurhash are captured at
/// upload so the storefront can reserve space and paint a placeholder.
model Media {
  id        String         @id @default(cuid())
  ownerType MediaOwnerType @map("owner_type")
  ownerId   String         @map("owner_id")
  url       String
  mimeType  String         @map("mime_type")
  width     Int
  height    Int
  blurhash  String?
  alt       String         @default("")
  position  Int            @default(0)
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([ownerType, ownerId, position])
  @@map("media")
}

enum CollectionType {
  MANUAL
  RULE
}

/// MANUAL collections list products explicitly via CollectionProduct.
/// RULE collections resolve membership from `rules` at query time:
/// { match: "all" | "any", conditions: [{ field, operator, value }] }.
model Collection {
  id             String         @id @default(cuid())
  handle         String         @unique
  title          String
  description    String         @default("")
  type           CollectionType @default(MANUAL)
  rules          Json?
  imageUrl       String?        @map("image_url")
  seoTitle       String?        @map("seo_title")
  seoDescription String?        @map("seo_description")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  products CollectionProduct[]

  @@map("collections")
}

model CollectionProduct {
  collectionId String @map("collection_id")
  productId    String @map("product_id")
  position     Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([collectionId, position])
  @@index([productId])
  @@map("collection_products")
}
