// Merged with the other files in prisma/schema/ by Prisma.

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Product {
  id             String        @id @default(cuid())
  handle         String        @unique
  title          String
  description    String        @default("")
  status         ProductStatus @default(DRAFT)
  vendor         String?
  tags           String[]      @default([])
  seoTitle       String?       @map("seo_title")
  seoDescription String?       @map("seo_description")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  options ProductOption[]

  @@index([status])
  @@index([vendor])
  @@map("products")
}

/// A product-level axis such as "Size" or "Colour". Values form the matrix
/// that generates variants.
model ProductOption {
  id        String  @id @default(cuid())
  productId String  @map("product_id")
  name      String
  position  Int     @default(0)

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@unique([productId, name])
  @@index([productId, position])
  @@map("product_options")
}

model ProductOptionValue {
  id       String @id @default(cuid())
  optionId String @map("option_id")
  value    String
  position Int    @default(0)

  option ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([optionId, value])
  @@index([optionId, position])
  @@map("product_option_values")
}
