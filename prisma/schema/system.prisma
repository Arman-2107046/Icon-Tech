// Cross-cutting models: auth and payment webhooks. Owned by src/lib, not
// by a commerce module.

/// Staff login. Only admins have passwords; customers use magic links.
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions Session[]

  @@map("admin_users")
}

enum SessionKind {
  ADMIN
  CUSTOMER
}

/// Cookie session. The cookie carries the raw token; the row stores its
/// SHA-256 so a database leak cannot be replayed. Exactly one of
/// adminUserId / customerId is set, matching `kind`.
model Session {
  id          String      @id @default(cuid())
  kind        SessionKind
  tokenHash   String      @unique @map("token_hash")
  adminUserId String?     @map("admin_user_id")
  customerId  String?     @map("customer_id")
  expiresAt   DateTime    @map("expires_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  lastSeenAt  DateTime    @default(now()) @map("last_seen_at")

  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  customer  Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([customerId])
  @@index([expiresAt])
  @@map("sessions")
}

/// One-time login link for customers. Single use: `usedAt` is set on
/// redemption and the row is refused afterwards.
model MagicLinkToken {
  id        String    @id @default(cuid())
  email     String
  /// Requesting client IP, for per-IP rate limiting.
  ip        String?
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@index([expiresAt])
  @@map("magic_link_tokens")
}

/// Raw inbound payment webhook, stored BEFORE any processing. The unique
/// (provider, eventId) pair makes redelivery a no-op; `processedAt` and
/// `error` record what the handler did with it.
model WebhookEvent {
  id          String          @id @default(cuid())
  provider    PaymentProvider
  eventId     String          @map("event_id")
  eventType   String          @map("event_type")
  payload     Json
  receivedAt  DateTime        @default(now()) @map("received_at")
  processedAt DateTime?       @map("processed_at")
  error       String?

  @@unique([provider, eventId])
  @@index([processedAt])
  @@map("webhook_events")
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

/// Outbound transactional email. Rows are written by the app and drained
/// by the /api/cron/send-emails worker, so a slow or failing provider never
/// blocks a checkout. `payload` holds the template inputs.
model EmailJob {
  id        String      @id @default(cuid())
  kind      String
  to        String
  subject   String
  payload   Json
  status    EmailStatus @default(QUEUED)
  attempts  Int         @default(0)
  lastError String?     @map("last_error")
  sentAt    DateTime?   @map("sent_at")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("email_jobs")
}
